{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtube.hafa.cc/schema/page.schema.json",
  "title": "SubTube info page",
  "description": "A page every client shows in the app and the website publishes: the privacy policy and the terms. Text is plain except for links, written [label](url) with an https: or mailto: address.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "web",
    "updated",
    "intro",
    "sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "web": {
      "type": "string",
      "pattern": "^https://subtube\\.hafa\\.cc/"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "intro": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "items"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[^\\[\\]]|\\[[^\\[\\]]+\\]\\((?:https|mailto):[^()\\s]+\\))*$"
    }
  }
}
