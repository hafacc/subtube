    },
    {
      "name": "a file that is not an object is skipped",
      "files": [
        {
          "deviceId": "a",
          "content": null
        },
        {
          "deviceId": "b",
          "content": []
        },
        {
          "deviceId": "c",
          "content": "device"
        },
        {
          "deviceId": "d",
          "content": 1
        },
        {
          "deviceId": "e",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {},
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": true
          }
        }
      }
    },
    {
