      }
    },
    {
      "name": "malformed entries are dropped, so they never win",
      "files": [
        {
          "deviceId": "bad",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000009,
                "filter": "x"
              },
              "UC2": {
                "at": 1759500000009
              },
              "UC3": {
                "filter": {
                  "enabled": true,
                  "regex": "no time",
                  "mode": "include"
                }
              },
              "UC4": {
                "at": "1759500000009",
                "filter": {
                  "enabled": true,
                  "regex": "string time",
                  "mode": "include"
                }
              },
              "UC5": null
            },
            "watched": {
              "v1": {
                "at": 1759500000009,
                "watched": "yes"
              },
              "v2": {
                "at": -1,
                "watched": true
              },
              "v3": {
                "at": 1759500000000.5,
                "watched": true
              },
              "v4": {
                "at": 9007199254740992,
                "watched": true
              },
              "v5": true,
              "v6": {
                "at": 1759500000009
              }
            }
          }
        },
        {
          "deviceId": "good",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "1",
                  "mode": "include"
                }
              },
              "UC2": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "2",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": false
              },
              "v2": {
                "at": 0,
                "watched": false
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000000,
            "filter": {
              "enabled": true,
              "regex": "1",
              "mode": "include"
            }
          },
          "UC2": {
            "at": 1759500000000,
            "filter": {
              "enabled": true,
              "regex": "2",
              "mode": "include"
            }
          }
        },
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": false
          },
          "v2": {
            "at": 0,
            "watched": false
          }
        }
      }
    },
    {
      "name": "the largest allowed at is kept",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 9007199254740991,
                "watched": true
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {},
        "watched": {
          "v1": {
            "at": 9007199254740991,
            "watched": true
          }
        }
      }
    },
    {
      "name": "a filter with unrecognized values is still merged as is",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "mode": "highlight",
                  "regex": "((x))"
                }
              }
            },
            "watched": {}
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000000,
            "filter": {
              "mode": "highlight",
              "regex": "((x))"
            }
          }
        },
        "watched": {}
      }
    },
    {
      "name": "a watched mark of false wins when newer",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        },
        {
          "deviceId": "b",
