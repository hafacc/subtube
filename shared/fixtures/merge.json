                "filter": {
                  "enabled": true,
                  "regex": "v2",
                  "mode": "include"
                }
              }
            },
            "watched": {}
          }
        },
        {
          "deviceId": "b",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "v1",
                  "mode": "include"
