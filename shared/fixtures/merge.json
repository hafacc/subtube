      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": "garbage",
            "watched": [
              {
                "at": 1759500000000,
                "watched": true
              }
            ]
          }
        },
        {
          "deviceId": "b",
          "content": {
            "version": 1,
