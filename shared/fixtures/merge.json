            "watched": {
              "v1": {
                "at": 1759500000002,
                "watched": true
              }
            }
          }
        },
        {
          "deviceId": "c",
          "content": {
            "version": 0,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000003,
                "watched": true
              }
            }
          }
        },
        {
          "deviceId": "d",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": false
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {},
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": false
          }
