        }
      }
    },
    {
      "name": "a newer older entry does not merge field by field",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "old",
                  "mode": "include",
                  "minDurationSeconds": 60
                }
              }
            },
            "watched": {}
          }
        },
        {
          "deviceId": "b",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000001,
                "filter": {
                  "enabled": true,
                  "regex": "new",
                  "mode": "include"
                }
              }
            },
            "watched": {}
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000001,
            "filter": {
              "enabled": true,
              "regex": "new",
              "mode": "include"
            }
          }
        },
        "watched": {}
      }
    },
    {
      "name": "unknown fields in the winning entry and filter are kept",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000001,
                "filter": {
                  "enabled": true,
                  "regex": "x",
                  "mode": "include",
                  "sortOrder": "newest",
                  "liveFilter": "premieres"
                },
                "editedOn": "tv"
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true,
                "progressSeconds": 42
              }
            }
          }
        },
        {
          "deviceId": "b",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "y",
                  "mode": "include"
                }
              }
            },
            "watched": {}
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000001,
            "filter": {
              "enabled": true,
              "regex": "x",
              "mode": "include",
              "sortOrder": "newest",
              "liveFilter": "premieres"
            },
            "editedOn": "tv"
          }
        },
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": true,
            "progressSeconds": 42
          }
        }
      }
    },
    {
      "name": "unknown top-level fields do not reach the merged view",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            },
            "playlists": {
              "PL1": {
                "at": 1759500000000
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {},
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": true
          }
        }
      }
    },
