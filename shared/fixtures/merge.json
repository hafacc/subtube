{
  "description": "Merging every device's file into one view. `files` are the device files as downloaded (`content` is the raw JSON, `deviceId` the <id> of device-<id>.json); `expected` is the merged view. Per key the entry with the greatest `at` wins; on equal `at` the greater deviceId (ASCII order) wins; the winning entry is kept whole, unknown fields included. A file that is not an object or whose `version` is not the number 1 is skipped; `channels`/`watched` that are missing or not objects read as empty; an entry that is not an object, whose `at` is not a whole number from 0 to 2^53-1, whose `filter` is not an object, or whose `watched` is not a boolean, is dropped. Filter field values are not checked here.",
  "cases": [
    {
      "name": "no files",
      "files": [],
      "expected": {
        "version": 1,
        "channels": {},
        "watched": {}
      }
    },
    {
      "name": "one file reads as itself",
      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "x",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000000,
            "filter": {
              "enabled": true,
              "regex": "x",
              "mode": "include"
            }
          }
        },
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": true
          }
        }
      }
    },
    {
      "name": "newest at wins per key",
      "files": [
        {
          "deviceId": "laptop",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000005,
                "filter": {
                  "enabled": true,
                  "regex": "laptop",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000001,
                "watched": true
              },
              "v2": {
                "at": 1759500000009,
                "watched": true
              }
            }
          }
        },
        {
          "deviceId": "phone",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000007,
                "filter": {
                  "enabled": true,
                  "regex": "phone",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000003,
                "watched": false
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000007,
            "filter": {
              "enabled": true,
              "regex": "phone",
              "mode": "include"
            }
          }
        },
        "watched": {
          "v1": {
            "at": 1759500000003,
            "watched": false
          },
          "v2": {
            "at": 1759500000009,
            "watched": true
          }
        }
      }
    },
    {
      "name": "file order does not matter",
      "files": [
        {
          "deviceId": "phone",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000007,
                "filter": {
                  "enabled": true,
                  "regex": "phone",
                  "mode": "include"
                }
              }
            },
            "watched": {}
          }
        },
        {
          "deviceId": "laptop",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000005,
                "filter": {
                  "enabled": true,
                  "regex": "laptop",
                  "mode": "include"
                }
              }
            },
            "watched": {}
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000007,
            "filter": {
              "enabled": true,
              "regex": "phone",
              "mode": "include"
            }
          }
        },
        "watched": {}
      }
    },
    {
      "name": "equal at: greater deviceId wins",
      "files": [
        {
          "deviceId": "b",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "b",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": false
              }
            }
          }
        },
        {
          "deviceId": "a",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "a",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        },
        {
          "deviceId": "B",
          "content": {
            "version": 1,
            "channels": {
              "UC1": {
                "at": 1759500000000,
                "filter": {
                  "enabled": true,
                  "regex": "B",
                  "mode": "include"
                }
              }
            },
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000000,
            "filter": {
              "enabled": true,
              "regex": "b",
              "mode": "include"
            }
          }
        },
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": false
          }
        }
      }
    },
    {
      "name": "deviceId order is ASCII, so digits sort before letters and hyphen before digits",
      "files": [
        {
          "deviceId": "9f",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        },
        {
          "deviceId": "a0",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": false
              }
            }
          }
        },
        {
          "deviceId": "-z",
          "content": {
            "version": 1,
            "channels": {},
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
