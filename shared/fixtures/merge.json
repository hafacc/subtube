      "files": [
        {
          "deviceId": "a",
          "content": {
            "version": 1
          }
        },
        {
          "deviceId": "b",
          "content": {
            "version": 1,
            "watched": {
              "v1": {
                "at": 1759500000000,
                "watched": true
              }
            }
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {},
        "watched": {
          "v1": {
            "at": 1759500000000,
            "watched": true
          }
        }
      }
    },
    {
