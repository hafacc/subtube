              }
            },
            "watched": {}
          }
        }
      ],
      "expected": {
        "version": 1,
        "channels": {
          "UC1": {
            "at": 1759500000000,
            "filter": {
              "enabled": true,
              "regex": "v1",
              "mode": "include"
            }
          }
        },
        "watched": {}
      }
    },
    {
      "name": "missing, string and zero versions are skipped",
      "files": [
        {
          "deviceId": "a",
