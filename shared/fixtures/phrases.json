    {
      "name": "build: one word is found as a whole word",
      "op": "build",
      "phrases": [
        "trailer"
      ],
      "pattern": "\\btrailer\\b",
      "canonical": [
        "trailer"
      ],
      "matches": [
        {
          "text": "Official Trailer",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "Official Trailer",
          "caseSensitive": true,
          "matches": false
