{
  "description": "Whether a channel's filter keeps a feed item. `filter` is a saved filter as stored in a device file; `item` holds only the fields the filter reads (absent means unknown). A filter field that is missing or holds an unrecognized value reads as its default; an invalid pattern reads as no pattern.",
  "cases": [
    {
      "name": "default filter keeps a plain video",
      "filter": {
        "enabled": true,
        "regex": "",
        "mode": "include"
      },
      "item": {
        "kind": "video",
        "title": "Hello World",
        "description": "",
        "durationSeconds": 600,
        "liveStatus": "normal",
        "isShort": false
      },
      "kept": true
    },
    {
      "name": "enabled false does not gate items (it only stops the main feed loading the channel)",
      "filter": {
        "enabled": false,
        "regex": "",
        "mode": "include"
      },
