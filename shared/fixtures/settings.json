          "at": 1759500000000,
          "value": "random"
        },
        "channelSort": {
          "at": 1759500000000,
          "value": "unwatched"
        },
        "autoplay": {
          "at": 1759500000000,
          "value": true
        },
        "timeChip": {
          "at": 1759500000000,
          "value": "month"
        },
        "topicChips": {
          "at": 1759500000000,
          "value": [
            "10",
            "20"
          ]
        },
        "channelTimeChip": {
          "at": 1759500000000,
          "value": "week"
        },
        "channelTopicChips": {
          "at": 1759500000000,
          "value": [
            "27"
          ]
        },
        "groupChips": {
          "at": 1759500000000,
          "value": [
            "Making",
            "Outdoors"
          ]
        },
        "channelGroupChips": {
          "at": 1759500000000,
          "value": [
            "Cooking"
          ]
        }
      },
      "expected": {
        "feedSort": "random",
        "channelSort": "unwatched",
        "autoplay": true,
        "timeChip": "month",
        "topicChips": [
          "10",
          "20"
        ],
        "channelTimeChip": "week",
        "channelTopicChips": [
          "27"
