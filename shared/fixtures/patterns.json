{
  "description": "Filter patterns: whether each pattern is valid (the meta regex accepts it), and for valid ones whether it is found in a text. See shared/patterns/README.md.",
  "cases": [
    {
      "name": "empty pattern",
      "pattern": "",
      "valid": true,
      "matches": [
        {
          "text": "anything",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "plain literal, case-insensitive by default",
      "pattern": "trailer",
      "valid": true,
      "matches": [
        {
          "text": "Official Trailer",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "Official Trailer",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "trail",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "literal space and punctuation",
      "pattern": "C# - part, 2!",
      "valid": true,
      "matches": [
        {
          "text": "c# - Part, 2!",
          "caseSensitive": false,
          "matches": true
        }
      ]
    },
    {
      "name": "slash is literal, escaped or not",
      "pattern": "AC/DC \\/ live",
      "valid": true,
      "matches": [
        {
          "text": "ac/dc / LIVE",
          "caseSensitive": false,
          "matches": true
        }
      ]
    },
    {
      "name": "escaped metacharacters",
      "pattern": "\\(live\\) \\[4K\\] \\{x\\} \\. \\* \\+ \\? \\| \\^ \\$ \\\\",
      "valid": true,
      "matches": [
        {
          "text": "(LIVE) [4k] {X} . * + ? | ^ $ \\ ",
          "caseSensitive": false,
          "matches": true
        }
      ]
    },
    {
      "name": "escaped plus as a literal",
      "pattern": "C\\+\\+",
      "valid": true,
      "matches": [
        {
          "text": "c++ tutorial",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "cpp",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "dot matches any character",
      "pattern": "a.c",
      "valid": true,
      "matches": [
        {
          "text": "abc",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "ac",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "dot matches a line break",
      "pattern": "a.c",
      "valid": true,
      "matches": [
        {
          "text": "a\nc",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a\r\nc",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "a\rc",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a\u2028c",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "dot matches one whole emoji",
      "pattern": "^.$",
      "valid": true,
      "matches": [
        {
          "text": "\ud83d\ude00",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "\u00e9",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "two dots do not match one emoji",
      "pattern": "^..$",
      "valid": true,
      "matches": [
        {
          "text": "\ud83d\ude00",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "emoji literal with a quantifier",
      "pattern": "\ud83d\ude00+$",
      "valid": true,
      "matches": [
        {
          "text": "yay\ud83d\ude00\ud83d\ude00",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "yay\ud83d\ude00\ud83d\ude02",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "emoji in a class",
      "pattern": "[\ud83d\ude00\ud83d\ude02]",
      "valid": true,
      "matches": [
        {
          "text": "lol\ud83d\ude02",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "lol",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "negated class matches one emoji",
      "pattern": "^[^a]$",
      "valid": true,
      "matches": [
        {
          "text": "\ud83d\ude00",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "class ranges",
      "pattern": "[0-9]+ ?min",
      "valid": true,
      "matches": [
        {
          "text": "10 MIN read",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "ten min",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "class letter ranges are case-insensitive by default",
      "pattern": "^[a-c]+$",
      "valid": true,
      "matches": [
        {
          "text": "ABC",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "ABC",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "abd",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "negated class, case-insensitive",
      "pattern": "^[^a-z]+$",
      "valid": true,
      "matches": [
        {
          "text": "ABC",
          "caseSensitive": false,
          "matches": false
        },
        {
          "text": "ABC",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "123",
          "caseSensitive": false,
          "matches": true
        }
      ]
    },
    {
      "name": "single letter in a class follows case",
      "pattern": "[x]",
      "valid": true,
      "matches": [
        {
          "text": "X",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "X",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "escaped characters in a class",
      "pattern": "^[\\]\\[\\-\\\\\\^]+$",
      "valid": true,
      "matches": [
        {
          "text": "]-[\\^",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "ampersand and colon in a class",
      "pattern": "^[a&:]+$",
      "valid": true,
      "matches": [
        {
          "text": "a&:",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "b",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "shorthands inside a class",
      "pattern": "^[\\d\\w\\s]+$",
      "valid": true,
      "matches": [
        {
          "text": "a_1 \t",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a-1",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "top-level alternation",
      "pattern": "cat|dog",
      "valid": true,
      "matches": [
        {
          "text": "Hot Dogs",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "bird",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "empty alternative matches everything",
      "pattern": "a|",
      "valid": true,
      "matches": [
        {
          "text": "xyz",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "empty group",
      "pattern": "x()y",
      "valid": true,
      "matches": [
        {
          "text": "xy",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "group with alternation and quantifier",
      "pattern": "(ep|episode) ?[0-9]+",
      "valid": true,
      "matches": [
        {
          "text": "Episode 12",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "Ep12",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "Epic",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "non-capturing group",
      "pattern": "(?:part|pt)\\.? ?[0-9]",
      "valid": true,
      "matches": [
        {
          "text": "Pt. 2",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "Part 3",
          "caseSensitive": false,
          "matches": true
        }
      ]
    },
    {
      "name": "two groups side by side",
      "pattern": "(a|b)(c|d)",
      "valid": true,
      "matches": [
        {
          "text": "xbd",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "xbe",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "exact count",
      "pattern": "^[0-9]{4}$",
      "valid": true,
      "matches": [
        {
          "text": "2026",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "20266",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "at least",
      "pattern": "^a{2,}$",
      "valid": true,
      "matches": [
        {
          "text": "aaa",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "between",
      "pattern": "^a{1,3}$",
      "valid": true,
      "matches": [
        {
          "text": "aaa",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "aaaa",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "zero count",
      "pattern": "^ab{0}c$",
      "valid": true,
      "matches": [
        {
          "text": "ac",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "abc",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "lazy quantifiers",
      "pattern": "^a+?b*?c??d{1,2}?$",
      "valid": true,
      "matches": [
        {
          "text": "aadd",
          "caseSensitive": true,
          "matches": true
        }
      ]
    },
    {
      "name": "start anchor",
      "pattern": "^shorts",
      "valid": true,
      "matches": [
        {
          "text": "Shorts: hi",
          "caseSensitive": false,
          "matches": true
        },
        {
          "text": "My Shorts",
          "caseSensitive": false,
          "matches": false
        }
      ]
    },
    {
      "name": "end anchor is the very end, not before a final line break",
      "pattern": "end$",
      "valid": true,
      "matches": [
        {
          "text": "the end",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "the end\n",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "the end\r\n",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "start anchor is the very start, not after a line break",
      "pattern": "^b",
      "valid": true,
      "matches": [
        {
          "text": "a\nb",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "anchors inside a group",
      "pattern": "(^a|b$)",
      "valid": true,
      "matches": [
        {
          "text": "ab",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "ba",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "digit is ASCII only",
      "pattern": "\\d",
      "valid": true,
      "matches": [
        {
          "text": "5",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "\u0663",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "\uff15",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "non-digit",
      "pattern": "^\\D+$",
      "valid": true,
      "matches": [
        {
          "text": "abc",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a1",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "word is ASCII only",
      "pattern": "^\\w+$",
      "valid": true,
      "matches": [
        {
          "text": "Abc_09",
          "caseSensitive": true,
          "matches": true
