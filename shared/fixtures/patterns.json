          "text": "a\u200bb",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "a\ufeffb",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "non-space",
      "pattern": "^\\S+$",
      "valid": true,
      "matches": [
        {
          "text": "ab",
          "caseSensitive": true,
          "matches": true
        },
        {
          "text": "a b",
          "caseSensitive": true,
          "matches": false
        },
        {
          "text": "a\u00a0b",
          "caseSensitive": true,
          "matches": false
        }
      ]
    },
    {
      "name": "tab and line break escapes",
