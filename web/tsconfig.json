{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "types": ["$app/types", "bun", "vite/client", "svelte"],
    "strict": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "*"],
  "exclude": ["src/service-worker"]
}
