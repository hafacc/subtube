{
  "manifest_version": 3,
  "name": "SubTube",
  "version": "0.1.0",
  "description": "Keeps the SubTube web app signed in to Google and checks which YouTube videos are Shorts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "externally_connectable": {
    "matches": ["https://subtube.hafa.cc/*", "http://localhost/*"]
  },
  "key": ""
}
