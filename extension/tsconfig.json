{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "webworker"],
    "types": ["chrome", "bun"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "build.ts"]
}
